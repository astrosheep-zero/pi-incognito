{
  "name": "@astrosheep/pi-incognito",
  "version": "0.1.1",
  "description": "Private Pi session segments using native null-device redirection.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astrosheep-zero/pi-incognito.git"
  },
  "homepage": "https://github.com/astrosheep-zero/pi-incognito#readme",
  "bugs": {
    "url": "https://github.com/astrosheep-zero/pi-incognito/issues"
  },
  "files": [
    "src",
    "README.md"
  ],
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@types/node": "^26.5.1",
    "typescript": "^6.0.2"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "pi --no-extensions -e ./src/index.ts --list-models __load_check__"
  }
}
